# Egress team settings. Copy to .env at the repo root (gitignored) and fill in.
# Share the filled-in file only through a password manager. PLAN.md section 3 T.
# Precedence: shell variables > services/runner/.env (optional local override) > this file.

# --- Nemotron (runner only; never reaches the browser) ---
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Runner registration; its sha256 is compiled into the SpacetimeDB module ---
EGRESS_SERVICE_SECRET=

# --- SpacetimeDB ---
# HTTP(S) address of the server. The runner and browser derive ws(s):// from it.
SPACETIME_URL=https://maincloud.spacetimedb.com
# Optional: what browsers connect to when it differs (home server: https://db.dontrepeatyourself.dev).
SPACETIME_PUBLIC_URL=
SPACETIME_DB=egress-dev
# Optional: the database's identity (hex). When set, npm run db:* targets it instead of the name.
SPACETIME_DB_IDENTITY=
# Token of the TEAM identity that owns the database (not a personal login). Used by npm run db:*.
SPACETIME_TOKEN=