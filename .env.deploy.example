# Publishing the SpacetimeDB module without an interactive spacetime login.
# Copy to .env.deploy (gitignored). See docs/SELF_HOSTING.md section 4.
SPACETIME_SERVER_URL=http://127.0.0.1:3010
SPACETIME_DB=egress
# Token of the publisher identity (POST /v1/identity on the server). Keep it in a password manager.
SPACETIME_PUBLISH_TOKEN=