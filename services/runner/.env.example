# Egress runner. Copy to .env (gitignored) and fill in. See docs/SELF_HOSTING.md section 5.
# Shared runner secret; its sha256 is compiled into the SpacetimeDB module.
EGRESS_SERVICE_SECRET=
# NVIDIA API key for Nemotron. Server-side only; never put it in the browser or a commit.
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Database the runner serves.
SPACETIME_URI=ws://127.0.0.1:3010
SPACETIME_DB=egress